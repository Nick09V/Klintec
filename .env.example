# ============================================================================
# KLINTEC v2.0 - VARIABLES DE ENTORNO (MODO HIBRIDO: NATIVO + DOCKER)
# Copia este archivo como `.env` en la raiz del proyecto:
#   Copy-Item .env.example .env
# ============================================================================

# --- 1. Base de Datos (PostgreSQL 16.6 + pgvector) ---
POSTGRES_USER=klintec
POSTGRES_PASSWORD=klintec2026
POSTGRES_DB=klintec_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://klintec:klintec2026@localhost:5432/klintec_db

# --- 2. Cache Parametrica y Cola Ligera (Redis 7.2) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- 3. Object Storage Local S3 (MinIO) ---
MINIO_ROOT_USER=klintecadmin
MINIO_ROOT_PASSWORD=klintec2026secret
MINIO_BUCKET=klintec-proposals
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

# --- 4. Proveedor Dual de IA para KlinBot y KlinVision ---
# Opciones validas: "mock" (100% offline determinista), "gemini", "openai"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 5. Parametros Legales Ecuador 2026 (Acuerdo MDT-2025-195 & IESS) ---
SBU_2026_USD=482.00
IESS_PATRONAL_PCT=0.1215
FONDO_RESERVA_PCT=0.0833
DECIMO_TERCERO_PCT=0.0833
DECIMO_CUARTO_MENSUAL_USD=40.17
VACACIONES_PCT=0.0417
RECARGO_NOCTURNO_PCT=0.25
FACTOR_REEMPLAZO_AUSENTISMO=1.18
HORAS_EFECTIVAS_TURNO=7.5

# --- 6. Puertos y URLs de Aplicacion ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
