{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuoteInput",
  "description": "Contrato de entrada para el motor de cálculo determinista de Klintec",
  "type": "object",
  "required": [
    "contrato",
    "zonas",
    "turnos",
    "opciones",
    "economicos",
    "maquinaria",
    "consumibles",
    "gastos_varios"
  ],
  "properties": {
    "contrato": {
      "type": "object",
      "required": ["sector", "tipo", "cliente", "tipologia", "plazo_meses", "fecha_inicio"],
      "properties": {
        "sector": { "type": "string", "enum": ["privado", "publico"] },
        "tipo": { "type": "string", "enum": ["recurrente", "unico"] },
        "cliente": { "type": "string", "minLength": 1 },
        "tipologia": {
          "type": "string",
          "enum": [
            "hospitalaria",
            "educativa",
            "corporativa",
            "industrial",
            "otra"
          ]
        },
        "plazo_meses": { "type": "integer", "enum": [1, 3, 6, 12, 24] },
        "fecha_inicio": { "type": "string", "format": "date" },
        "urgente": { "type": "boolean" },
        "codigo_proceso": { "type": "string" },
        "presupuesto_referencial": { "type": "number", "minimum": 0 }
      }
    },
    "zonas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "nombre",
          "tipo_zona",
          "riesgo",
          "superficie",
          "m2",
          "suciedad",
          "nivel",
          "obstaculos",
          "metodo",
          "frecuencia",
          "visitas_mes",
          "quimico_id"
        ],
        "properties": {
          "nombre": { "type": "string", "minLength": 1 },
          "tipo_zona": { "type": "string" },
          "riesgo": {
            "type": "string",
            "enum": [
              "critico",
              "semicritico",
              "no_critico",
              "alimentos",
              "general"
            ]
          },
          "superficie": {
            "type": "string",
            "enum": [
              "vinilo",
              "ceramica",
              "piedra",
              "madera",
              "alfombra",
              "epoxico",
              "vidrio",
              "acero"
            ]
          },
          "m2": { "type": "number", "exclusiveMinimum": 0 },
          "suciedad": {
            "type": "string",
            "enum": ["ligera", "media", "pesada"]
          },
          "nivel": { "type": "string", "enum": ["basico", "estandar", "alto"] },
          "obstaculos": { "type": "string", "enum": ["bajo", "medio", "alto"] },
          "metodo": { "type": "string", "enum": ["manual", "maquina"] },
          "maquina_id": { "type": ["string", "null"] },
          "frecuencia": { "type": "string" },
          "visitas_mes": { "type": "number", "minimum": 1 },
          "quimico_id": { "type": "string" }
        }
      }
    },
    "turnos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dias", "inicio", "fin", "personas"],
        "properties": {
          "dias": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["L", "M", "X", "J", "V", "S", "D"]
            }
          },
          "inicio": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$"
          },
          "fin": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$"
          },
          "personas": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "opciones": {
      "type": "object",
      "required": [
        "opera_feriados",
        "permitir_parcial",
        "personal_mas_1_anio",
        "ausentismo_pct",
        "salario_base"
      ],
      "properties": {
        "opera_feriados": { "type": "boolean" },
        "permitir_parcial": { "type": "boolean" },
        "personal_mas_1_anio": { "type": "boolean" },
        "ausentismo_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "salario_base": { "type": "number", "minimum": 482 },
        "horas_disponibles": { "type": "number", "exclusiveMinimum": 0 },
        "personas_maximas": { "type": "integer", "minimum": 1 }
      }
    },
    "economicos": {
      "type": "object",
      "required": [
        "supervision_pct",
        "indirectos_pct",
        "utilidad_pct",
        "merma_pct",
        "iva_pct"
      ],
      "properties": {
        "supervision_pct": { "type": "number", "minimum": 0 },
        "indirectos_pct": { "type": "number", "minimum": 0 },
        "utilidad_pct": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 100
        },
        "merma_pct": { "type": "number", "minimum": 0 },
        "iva_pct": { "type": "number", "minimum": 0 }
      }
    },
    "maquinaria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["maquinaria_id", "horas_uso_mensual"],
        "properties": {
          "maquinaria_id": { "type": "string", "minLength": 1 },
          "horas_uso_mensual": { "type": "number", "minimum": 0 }
        }
      }
    },
    "consumibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumible_id", "cantidad_mensual"],
        "properties": {
          "consumible_id": { "type": "string", "minLength": 1 },
          "cantidad_mensual": { "type": "number", "minimum": 0 }
        }
      }
    },
    "gastos_varios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["descripcion", "monto_mensual"],
        "properties": {
          "descripcion": { "type": "string", "minLength": 1 },
          "monto_mensual": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
